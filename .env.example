DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Dedicated verified sports-data provider (primary for scores/standings).
# Obtain the API key from https://dashboard.api-football.com/
# Keep the key server-side; the free plan is capped at 100 requests/day.
API_FOOTBALL_KEY=
API_FOOTBALL_COUNTRY=Ethiopia
API_FOOTBALL_BASE=https://v3.football.api-sports.io
# 3600 seconds by default, reduce to 60 on a plan with enough API calls.
API_FOOTBALL_CACHE_SECONDS=3600

# International-only scoreboard powered by documented TheSportsDB free v1 API.
# No key needed (its public key 123); returns at most 3 fixtures per league/day
# and top 5 standings. Use on web/dev only, not published app-store apps.
FOOTBALL_SOURCE=thesportsdb

# Google Gemini remains a separate, non-authoritative fallback for public
# football information/news. Quota exhaustion must never invent scores.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Deployment refresh: 2026-08-22T07:28:00Z

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Secret used by trusted ingestion/notification jobs.
PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret
