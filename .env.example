DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini — sole upstream source for public football scores, fixtures,
# standings and football news. Keep this key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Deployment refresh: 2026-08-22T07:28:00Z

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Secret used by trusted ingestion/notification jobs.
PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret
