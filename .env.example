DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Real football data — API-Football / API-Sports
# Create a key at the API-Football dashboard and keep it server-side only.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_FOOTBALL_COUNTRY=Ethiopia
# Optional overrides. Leave blank to auto-discover the current Ethiopian Premier League.
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_SEASON=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Secret used by trusted ingestion/notification jobs.
PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret
